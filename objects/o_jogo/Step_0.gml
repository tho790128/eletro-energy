global.vida = clamp(global.vida,0,global.p_max_vida)

if global.up_dano_dash2 global.p_dano = 2

if global.up_tempo_dash2 global.p_temp_dash = 10

if global.up_vel_dash2 global.p_vel_dash = 20
    
if global.up_vida1 global.p_max_vida = 8
if global.up_vida2 global.p_max_vida = 10
if global.up_vida3 global.p_max_vida = 12
    
if global.up_multi_coin1 global.p_multi_coin = 1.2
if global.up_multi_coin2 global.p_multi_coin = 1.5
if global.up_multi_coin3 global.p_multi_coin = 1.8
if global.up_multi_coin4 global.p_multi_coin = 2
    
if global.up_regen global.p_regen = true
    


